---
const items = [
  {
    title: "Self-service booking",
    desc: "Members book your classes and 1:1 sessions themselves, from their phone. Recurring schedules, per-class capacity, booking windows.",
    icon: "calendar",
  },
  {
    title: "Passes that count themselves down",
    desc: "Sell session packs or unlimited memberships. Every booking decrements the pass automatically — no more tracking who has sessions left in your head.",
    icon: "ticket",
  },
  {
    title: "Cancel in-window, auto-refund",
    desc: "A member cancels inside your window and the session returns to their pass automatically. You're not the refund desk.",
    icon: "refund",
  },
  {
    title: "One-tap holiday closures",
    desc: "Close for a date range in one tap: Atlas cancels the classes, refunds everyone, extends their passes so no one loses paid days, and notifies each member once.",
    icon: "sun",
  },
];
---

<section class="booking section" id="booking">
  <div class="container">
    <div class="booking-header">
      <p class="text-overline booking-label">Bookings &amp; passes — live now</p>
      <h2 class="booking-heading">Run your classes. The admin runs itself.</h2>
      <p class="booking-sub">
        Booking, packages and attendance in the same app your members already
        open — you take payment your way, and Atlas tracks every session.
      </p>
    </div>

    <ul class="booking-grid">
      {items.map((item) => (
        <li class="booking-card">
          <span class="booking-icon" aria-hidden="true">
            {item.icon === "calendar" && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--coral-600)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg>
            )}
            {item.icon === "ticket" && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--coral-600)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2 2 2 0 0 0 0 4 2 2 0 0 1-2 2H5a2 2 0 0 1-2-2 2 2 0 0 0 0-4z"/><path d="M14 6v12"/></svg>
            )}
            {item.icon === "refund" && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--coral-600)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8a9 9 0 1 1-1.5 5"/><path d="M3 4v4h4"/></svg>
            )}
            {item.icon === "sun" && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--coral-600)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            )}
          </span>
          <div>
            <h3 class="booking-card-title">{item.title}</h3>
            <p class="booking-card-desc">{item.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .booking {
    background: var(--light-surface-1);
  }

  .booking-header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-9);
  }

  .booking-label {
    color: var(--teal-600);
    margin-bottom: var(--space-3);
  }

  .booking-heading {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 800;
    color: var(--navy-700);
    letter-spacing: -0.3px;
  }

  .booking-sub {
    margin-top: var(--space-4);
    font-size: 16px;
    line-height: 1.6;
    color: var(--light-text-secondary);
  }

  .booking-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    max-width: 900px;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .booking-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }

  .booking-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--light-surface-2);
    border: 1px solid var(--light-border);
    border-radius: var(--radius-lg);
  }

  .booking-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--coral-100, rgba(226, 115, 92, 0.12));
    border-radius: var(--radius-md);
  }

  .booking-card-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--navy-700);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }

  .booking-card-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--light-text-secondary);
  }
</style>
